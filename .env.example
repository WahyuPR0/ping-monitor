# ==============================================================================
# PING MONITOR CONFIGURATION
# ==============================================================================

# Server Web Port
# Default: 80 (Bisa langsung dibuka di browser tanpa mengetikkan port, e.g. http://localhost)
# Jika port 80 digunakan aplikasi lain, sistem otomatis fallback ke port 8080.
PORT=80

# Kustomisasi Target Ping yang Dipantau
# Format: host:Label,host:Label atau hanya host,host
# Kosongkan untuk menggunakan target bawaan (Cloudflare, Google, WhatsApp Chat, WA Media, YouTube)
# Contoh: PING_TARGETS=1.1.1.1:Cloudflare DNS,8.8.8.8:Google Public DNS,detik.com:Detik,kompas.com:Kompas
PING_TARGETS=1.1.1.1:Cloudflare DNS,8.8.8.8:Google Public DNS,c.whatsapp.net:WhatsApp Chat,mmg.whatsapp.net:WhatsApp Media CDN,youtube.com:YouTube

# Integrasi Ping MikroTik RouterOS (Dual-Source Telemetry)
# Nilai: false (Default / Disarankan untuk pemula - hanya ping dari Host/Laptop/PC)
# Nilai: true  (Aktifkan hanya jika Anda menghubungkan router MikroTik via RouterOS API)
ENABLE_ROUTER_PING=false

# Konfigurasi Koneksi Router MikroTik
# Hanya diproses jika ENABLE_ROUTER_PING=true atau saat tombol toggle MikroTik diaktifkan
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
